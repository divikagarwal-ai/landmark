{
  "paths": {
    "/api/v1/conversation/whatsapp-send-messages": {
      "post": {
        "tags": ["Social Media Conversation"],
        "parameters": [
          {
            "in": "header",
            "name": "auth-Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reference_uuid_column_name": {
                    "type": "string",
                    "default": null
                  },
                  "reference_uuid_column_value": {
                    "type": "string",
                    "default": null
                  },
                  "fromNumber": {
                    "type": "string",
                    "default": null
                  },
                  "toNumber": {
                    "type": "string",
                    "default": "+91"
                  },
                  "message": {
                    "type": "string",
                    "default": ""
                  },
                  "is_automatic_message": {
                    "type": "number",
                    "default": 0
                  },
                  "templateName": {
                    "type": "string",
                    "default": ""
                  },
                  "objectVariables": {
                    "type": "object",
                    "properties": {
                      "headerVar": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "default": "text | number"
                            },
                            "value": {
                              "type": "string",
                              "default": ""
                            }
                          }
                        }
                      },
                      "bodyVar": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "default": "text | number"
                            },
                            "value": {
                              "type": "string",
                              "default": ""
                            }
                          }
                        }
                      },
                      "footerVar": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "default": "text | number"
                            },
                            "value": {
                              "type": "string",
                              "default": ""
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
