          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "conversation_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully changed internal status"
          }
        }
