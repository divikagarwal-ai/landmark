    "/api/v1/general/send-grid-email": {
      "post": {
        "tags": ["General"],
        "summary": "Send an email",
        "description": "This endpoint sends an email with the provided details.",
        "parameters": [
          {
            "in": "header",
            "name": "auth-Token",
            "description": "",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "module_name": {
                    "type": "string",
                    "default": ""
                  },
                  "module_uuid": {
                    "type": "string",
                    "default": ""
                  },
                  "comment": {
                    "type": "string",
                    "default": ""
                  },
                  "emails": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "default": ""
                    }
                  },
                  "subject": {
                    "type": "string",
                    "default": ""
                  },
                  "body": {
                    "type": "string",
                    "default": ""
                  },
                  "templateName": {
                    "type": "string",
                    "default": null
                  },
                  "templateId": {
                    "type": "string",
                    "default": null
                  },
                  "objectVariables": {
                    "type": "object"
                  },
                  "cc": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "default": ""
                    }
                  },
                  "bcc": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "default": ""
                    }
                  },
                  "reply_to": {
                    "type": "object",
                    "properties": {
                      "email": {
                        "type": "string",
                        "default": null
                      },
                      "name": {
                        "type": "string",
                        "default": ""
                      }
                    }
                  },
                  "attachments": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "content": {
                          "type": "string",
                          "default": ""
                        },
                        "filename": {
                          "type": "string",
                          "default": ""
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Email sent successfully"
          },
          "400": {
            "description": "Bad request, invalid input"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
