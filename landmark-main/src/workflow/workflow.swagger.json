            "schema": {
              "type": "string"
            },
            "description": "Format will be YYYY-MM-DD."
          },
          {
            "in": "query",
            "name": "column",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "default": ""
              }
            },
            "description": "Column name for search value."
          },
          {
            "in": "query",
            "name": "value",
            "schema": {
              "type": "string"
            },
            "description": "Search according to"
          },
          {
            "in": "query",
            "name": "pageNo",
            "description": "",
            "required": true,
            "schema": {
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "itemPerPage",
            "description": "",
            "required": true,
            "schema": {
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "pageLimit",
            "schema": {
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "advanceFilter",
            "schema": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "column": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "default": [""]
                  },
                  "operator": {
                    "type": "string",
                    "default": "EQUAL",
                    "enum": [
                      "EQUAL",
                      "NOT_EQUAL",
                      "GREATER",
                      "LESSER",
                      "GREATER_THAN_EQUAL",
                      "LESSER_THAN_EQUAL",
                      "CONTAINS",
                      "STARTS_WITH",
                      "ENDS_WITH",
                      "DATE_RANGE"
                    ]
                  },
                  "value": {
                    "type": "string",
                    "default": ""
                  },
                  "logicalOperator": {
                    "type": "string",
                    "default": "AND",
                    "enum": ["AND", "OR"]
                  }
                }
              }
            },
            "description": "Advanced filters for complex lead queries."
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/api/v1/workflow/upsert-workflow-condition": {
      "post": {
        "tags": ["Work Flow"],
        "summary": "Create or update workflow condition",
        "description": "",
        "parameters": [
          {
            "in": "header",
            "name": "auth-Token",
            "schema": {
              "type": "string"
            },
            "required": true,
