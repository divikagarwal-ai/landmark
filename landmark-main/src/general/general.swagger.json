    "/api/v1/general/microsoftgraph/send-email": {
      "post": {
        "tags": ["General"],
        "summary": "Send an email",
        "description": "This endpoint sends an email with the provided details.",
        "parameters": [
          {
            "in": "header",
            "name": "auth-Token",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "default": ""
                  },
                  "subject": {
                    "type": "string",
                    "default": "",
                    "description": "Subject of the email"
                  },
                  "body": {
                    "type": "object",
                    "description": "Body/content of the email",
                    "properties": {
                      "contentType": {
                        "type": "string",
                        "default": "Text"
                      },
                      "content": {
                        "type": "string",
                        "default": ""
                      }
                    }
                  },
                  "toRecipients": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "emailAddress": {
                          "type": "object",
                          "properties": {
                            "address": {
                              "type": "string",
                              "default": ""
                            }
                          }
                        }
                      }
                    }
                  },
                  "ccRecipients": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "emailAddress": {
                          "type": "object",
                          "properties": {
                            "address": {
                              "type": "string",
                              "default": ""
                            }
                          }
                        }
                      }
                    }
                  },
                  "attachments": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "default": ""
                        },
                        "contentType": {
                          "type": "string",
                          "default": ""
                        },
                        "contentBytes": {
                          "type": "string",
                          "default": ""
                        }
                      },
                      "required": ["name", "content"]
                    },
                    "description": "Attachments to include in the email"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Email sent successfully"
          },
          "400": {
            "description": "Bad request, invalid input"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
