    "/api/v1/general/generate-dynamic-sql": {
      "post": {
        "tags": ["General"],
        "summary": "Generate Dynamic SQL.",
        "parameters": [
          {
            "in": "header",
            "name": "auth-Token",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "views": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "default": ""
                    }
                  },
                  "onConditions": {
                    "type": "object",
                    "properties": {
                      "selected-second-view-onward": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "and|or": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "column": {
                                    "type": "string",
                                    "default": "payload1.column1"
                                  },
                                  "operant": {
                                    "type": "string",
                                    "default": "EQUAL | NOT_EQUAL | GREATER | LESSER | GREATER_THAN_EQUAL | LESSER_THAN_EQUAL"
                                  },
                                  "columnOrValue": {
                                    "type": "string",
                                    "default": "payload2.column1 | value1"
                                  },
                                  "isColumnComparison": {
                                    "type": "boolean",
                                    "default": false
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "whereConditions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "and|or": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "column": {
                                "type": "string",
                                "default": "payload1.column1"
                              },
                              "operant": {
                                "type": "string",
                                "default": "EQUAL | NOT_EQUAL | GREATER | LESSER | GREATER_THAN_EQUAL | LESSER_THAN_EQUAL"
                              },
                              "columnOrValue": {
                                "type": "string",
                                "default": "payload2.column1 | value1"
                              },
                              "isColumnComparison": {
                                "type": "boolean",
                                "default": false
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
