    "/api/v1/conversation/link-whatsapp-group-to-module": {
      "post": {
        "tags": ["Social Media Conversation"],
        "summary": "Link WhatsApp group to a module",
        "parameters": [
          {
            "in": "header",
            "name": "auth-Token",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "group_id": {
                    "type": "string",
                    "description": "WhatsApp group ID",
                    "default": ""
                  },
                  "module_name": {
                    "type": "string",
                    "description": "Name of the module to link",
                    "default": ""
                  },
                  "module_uuid": {
                    "type": "string",
                    "description": "UUID of the module",
                    "default": ""
                  },
                  "status": {
                    "type": "string",
                    "description": "Status of the mapping",
                    "default": "ACTIVE"
                  }
                },
                "required": ["group_id"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully linked WhatsApp group to module"
          },
          "400": {
            "description": "Bad Request"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
