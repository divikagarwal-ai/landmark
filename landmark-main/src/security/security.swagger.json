    "/api/v1/security/upsert-role-group": {
      "post": {
        "tags": ["Security"],
        "summary": "Create or update role groups.",
        "parameters": [
          {
            "in": "header",
            "name": "auth-Token",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Authentication token required for API access."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "role_group_uuid": {
                    "type": "string",
                    "default": null,
                    "description": "Unique identifier for the role group (required for updates)."
                  },
                  "role_group": {
                    "type": "string",
                    "default": null,
                    "description": "Name of the role group."
                  },
                  "status": {
                    "type": "string",
                    "default": "ACTIVE",
                    "description": "Status of the role group (e.g., ACTIVE, INACTIVE)."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Role group created or updated successfully."
          },
          "400": {
            "description": "Bad Request - Invalid or missing parameters."
          },
          "404": {
            "description": "Not Found - Role group not found."
          },
          "401": {
            "description": "Unauthorized - Invalid authentication token."
          },
          "500": {
            "description": "Internal Server Error."
          }
        }
      }
    },

