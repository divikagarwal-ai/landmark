{
  "paths": {
    "/api/v1/workflow/upsert-workflow-basic": {
      "post": {
        "tags": ["Work Flow"],
        "summary": "Create or update workflow basic definition",
        "description": "",
        "parameters": [
          {
            "in": "header",
            "name": "auth-Token",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "The authorization token for the logged-in user."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "workflow_basic_uuid": {
                    "type": "string",
                    "default": null
                  },
                  "workflow_basic_code": {
                    "type": "string",
                    "default": null
                  },
                  "workflow_name": {
                    "type": "string",
                    "required": true,
                    "description": "Name of the workflow"
                  },
                  "run_as": {
                    "type": "string",
                    "required": true,
                    "enum": ["MANUAL", "CRON", "REAL_TIME"],
                    "description": "Whether workflow runs manually, as scheduled CRON, or in real-time"
                  },
                  "real_time_type": {
                    "type": "string",
                    "enum": ["CREATE", "SELF_CHANGES", "CUSTOM"],
                    "description": "Type of real-time workflow trigger"
                  },
                  "module_name": {
                    "type": "string",
                    "description": "Name of the module this workflow belongs to"
                  },
                  "endpoint_path": {
                    "type": "string",
                    "default": ""
                  },
                  "cron_schedule_at": {
                    "type": "object",
                    "properties": {
                      "second": {
                        "type": "string",
                        "description": "0-59"
                      },
                      "minute": {
                        "type": "string",
                        "description": "0-59"
                      },
                      "hour": {
                        "type": "string",
                        "description": "0-23"
                      },
                      "date": {
                        "type": "string",
                        "description": "1-31"
                      },
                      "month": {
                        "type": "string",
                        "description": "1-12"
                      },
                      "week": {
                        "type": "string",
                        "description": "0-7"
                      },
                      "repeatEvery": {
                        "type": "boolean"
                      }
                    }
                  },
                  "nodes": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "edges": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "status": {
                    "type": "string",
                    "enum": ["ACTIVE", "INACTIVE"],
                    "default": "ACTIVE",
                    "description": "Current status of the workflow"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation"
          },
          "401": {
            "description": "Unauthorized"
          },
          "406": {
            "description": "Workflow with this module name already exists"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/v1/workflow/get-workflow-basic": {
      "get": {
        "tags": ["Work Flow"],
        "summary": "Work flow basic get.",
        "parameters": [
          {
            "in": "header",
