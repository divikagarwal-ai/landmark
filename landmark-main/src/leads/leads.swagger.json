                    "maxLength": 500,
                    "required": true
                  },
                  "last_name": {
                    "type": "string",
                    "maxLength": 500,
                    "required": true
                  },
                  "email": {
                    "type": "string",
                    "maxLength": 1000,
                    "required": true
                  },
                  "phone": {
                    "type": "string",
