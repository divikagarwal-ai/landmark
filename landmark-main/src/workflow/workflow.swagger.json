          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "workflow_condition_uuid": {
                    "type": "string",
                    "default": null
                  },
                  "workflow_condition_code": {
                    "type": "string",
                    "default": null
                  },
                  "workflow_basic_code": {
                    "type": "string",
                    "default": "",
                    "required": true
                  },
                  "call_type": {
                    "type": "string",
                    "enum": ["API", "SQL"],
                    "required": true
                  },
                  "conditions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "and": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "column": {
                                "type": "string",
                                "description": "e.g., view.column1 or view.*.new_column"
                              },
                              "operant": {
                                "type": "string",
                                "enum": [
                                  "EQUAL",
                                  "NOT_EQUAL",
                                  "GREATER",
                                  "LESSER",
                                  "GREATER_THAN_EQUAL",
                                  "LESSER_THAN_EQUAL"
                                ]
                              },
                              "columnOrValue": {
                                "type": "string",
                                "description": "e.g., view.column1, value1, or view.*.old_column"
                              },
                              "isColumnComparison": {
                                "type": "boolean",
                                "default": false
                              }
                            }
                          }
                        },
                        "or": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "column": {
                                "type": "string",
                                "description": "e.g., view.column1 or view.*.new_column"
                              },
                              "operant": {
                                "type": "string",
                                "enum": [
                                  "EQUAL",
                                  "NOT_EQUAL",
                                  "GREATER",
                                  "LESSER",
                                  "GREATER_THAN_EQUAL",
                                  "LESSER_THAN_EQUAL"
                                ]
                              },
                              "columnOrValue": {
                                "type": "string",
                                "description": "e.g., view.column1, value1, or view.*.old_column"
                              },
                              "isColumnComparison": {
                                "type": "boolean",
                                "default": false
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "sql_statement": {
                    "type": "string",
                    "default": null
                  },
                  "ui_related": {
                    "type": "array",
                    "default": []
                  },
                  "nodes": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "status": {
                    "type": "string",
                    "enum": ["ACTIVE", "INACTIVE"],
                    "default": "ACTIVE"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation"
          },
          "400": {
            "description": "Invalid workflow Basic"
          },
          "401": {
            "description": "Unauthorized"
