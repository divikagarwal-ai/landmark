{
  "paths": {
    "/api/v1/review/google-reviews/webhook": {
      "post": {
        "tags": ["Review"],
        "summary": "Webhook endpoint to receive Google Business Profile reviews",
        "description": "Receives review data from IFTTT when a new Google Business review is posted",
        "parameters": [
          {
            "in": "header",
            "name": "X-Webhook-Key",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "API key for webhook authentication"
          },
          {
            "in": "query",
            "name": "api_key",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Alternative API key in query parameter"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "author_name": {
                    "type": "string",
                    "description": "Name of the reviewer"
                  },
                  "review_id": {
                    "type": "string",
                    "description": "Review ID"
                  },
                  "rating": {
                    "type": "string",
                    "description": "Rating given (1-5)"
                  },
                  "review_text": {
                    "type": "string",
                    "description": "Review content"
                  },
                  "create_time": {
                    "type": "string",
                    "description": "When the review was posted"
                  },
                  "location_name": {
                    "type": "string",
                    "description": "URL to the review on Google"
                  }
                },
                "required": ["author_name", "rating"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Review saved successfully"
          },
          "401": {
            "description": "Unauthorized webhook call"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/v1/review/google-reviews": {
      "get": {
        "tags": ["Review"],
        "summary": "Get Google Business Profile reviews",
        "description": "Retrieve saved Google Business reviews with filtering and pagination",
        "parameters": [
          {
            "in": "header",
            "name": "auth-Token",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "The authorization token for the logged-in user."
          },
          {
            "in": "query",
            "name": "review_id",
            "schema": {
              "type": "string"
            },
            "description": "Filter by rating"
          },
          {
            "in": "query",
            "name": "google_reviews_uuid",
            "schema": {
              "type": "string"
            },
            "description": "Filter by rating"
          },
          {
            "in": "query",
            "name": "rating",
            "schema": {
              "type": "string"
            },
            "description": "Filter by rating"
          },
          {
            "in": "query",
            "name": "pageNo",
            "schema": {
              "type": "integer",
              "default": 1
            },
            "description": "Page number for pagination"
          },
          {
            "in": "query",
            "name": "itemPerPage",
            "schema": {
              "type": "integer",
              "default": 10
            },
            "description": "Number of items per page"
          },
          {
            "in": "query",
            "name": "from_date",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Filter reviews from this date (YYYY-MM-DD)"
          },
          {
            "in": "query",
            "name": "to_date",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Filter reviews up to this date (YYYY-MM-DD)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/v1/review/review-suggestion": {
      "get": {
        "tags": ["Review"],
        "summary": "Get AI-powered review analysis and suggestions",
        "description": "Analyzes a Google review and provides sentiment analysis, suggested actions, and response recommendations",
        "parameters": [
          {
            "in": "header",
            "name": "auth-Token",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "The authorization token for the logged-in user."
          },
          {
            "in": "query",
            "name": "review_id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID of the Google review to analyze"
          }
        ],
        "responses": {
          "200": {
            "description": "Review analysis created successfully"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Review Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/v1/review/review-analytics": {
      "get": {
        "tags": ["Review"],
        "summary": "Get review analytics based on keywords",
        "description": "Retrieve either keyword counts or suggested actions based on keywords",
        "parameters": [
          {
            "in": "header",
            "name": "auth-Token",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "The authorization token for the logged-in user."
          },
          {
            "in": "query",
            "name": "type",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["count", "list"]
            },
            "description": "Type of analytics to retrieve (count for keyword counts, list for suggested actions)"
          },
          {
            "in": "query",
            "name": "keywords",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Keywords to filter by (required for type=list)"
          },
          {
            "in": "query",
            "name": "from_date",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Start date for filtering reviews"
          },
          {
            "in": "query",
            "name": "to_date",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "End date for filtering reviews"
          },
          {
            "in": "query",
            "name": "pageNo",
            "schema": {
              "type": "integer",
              "default": 1
            },
            "description": "Page number for pagination (only for type=list)"
          },
          {
            "in": "query",
            "name": "itemPerPage",
            "schema": {
              "type": "integer",
              "default": 10
            },
            "description": "Number of items per page (only for type=list)"
          },
          {
            "in": "query",
            "name": "status",
            "schema": {
              "type": "string"
            },
            "description": "Filter by status"
          },
          {
            "in": "query",
            "name": "advanceFilter",
            "schema": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "column": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "operator": {
                    "type": "string",
                    "enum": [
                      "EQUAL",
                      "NOT_EQUAL",
                      "GREATER",
                      "LESSER",
                      "GREATER_THAN_EQUAL",
                      "LESSER_THAN_EQUAL",
                      "CONTAINS",
                      "STARTS_WITH",
                      "ENDS_WITH",
                      "DATE_RANGE"
                    ]
                  },
                  "value": {
                    "type": "string"
                  },
                  "logicalOperator": {
                    "type": "string",
                    "enum": ["AND", "OR"]
                  }
                }
              }
            },
            "description": "Advanced filtering options"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation"
          },
          "400": {
            "description": "Bad Request - Invalid parameters"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/v1/review/analyze-review": {
      "post": {
        "tags": ["Review"],
        "summary": "Analyze a review and generate a response",
        "description": "Analyzes a review and generates a response based on the provided parameters",
        "parameters": [
          {
            "in": "header",
            "name": "auth-Token",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "The authorization token for the logged-in user."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "description": "The review text to analyze"
                  },
                  "stars": {
                    "type": "integer",
                    "description": "Star rating of the review (1-5)"
                  },
                  "responseStyle": {
                    "type": "string",
                    "description": "Style of the response",
                    "enum": [
                      "casual",
                      "formal",
                      "personalized",
                      "let GPT decide"
                    ]
                  },
                  "includeEmojis": {
                    "type": "boolean",
                    "description": "Whether to include emojis in the response"
                  },
                  "responseLength": {
                    "type": "integer",
                    "description": "Desired length of the response (25-80 words)"
                  },
                  "keywords": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Keywords to include in the response"
                  },
                  "avoidKeywords": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Keywords to avoid in the response"
                  },
                  "referToSelfAsIndividual": {
                    "type": "boolean",
                    "description": "Whether to refer to self as 'I' or 'We'"
                  },
                  "mentionNames": {
                    "type": "boolean",
                    "description": "Whether to mention names in the response"
                  },
                  "name": {
                    "type": "string",
                    "description": "Name to mention in the response if applicable"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Review analyzed and response generated successfully"
          },
          "400": {
            "description": "Bad Request - Invalid parameters"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/v1/review/review-analysis": {
      "get": {
        "tags": ["Review"],
        "summary": "Retrieve all leads or specific lead by ID",
        "description": "",
        "parameters": [
          {
            "in": "header",
            "name": "auth-Token",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "The authorization token for the logged-in user."
          },

          {
            "in": "query",
            "name": "review_analysis_uuid",
            "schema": {
              "type": "string",
              "default": null
            },
            "description": "A unique UUID associated with the review analysis."
          },
          {
            "in": "query",
            "name": "review_id",
            "schema": {
              "type": "string",
              "default": null
            },
            "description": "A unique UUID associated with the review analysis."
          }, {
            "in": "query",
            "name": "review_analysis_id",
            "schema": {
              "type": "string",
              "default": null
            },
            "description": "A unique UUID associated with the review analysis."
          }, {
            "in": "query",
            "name": "review_analysis_unique_id",
            "schema": {
              "type": "string",
              "default": null
            },
            "description": "A unique UUID associated with the review analysis."
          },
          {
            "in": "query",
            "name": "status",
            "schema": {
              "type": "string"
            },
            "description": "Status of the lead, e.g., ACTIVE, DEAD, or OPPORTUNITY."
          },
          {
            "in": "query",
            "name": "to_date",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Upper date range for filtering leads (YYYY-MM-DD)."
          },
          {
            "in": "query",
            "name": "from_date",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Lower date range for filtering leads (YYYY-MM-DD)."
          },
          {
            "in": "query",
            "name": "column",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Columns to include in the result."
          },
          {
            "in": "query",
            "name": "value",
            "schema": {
              "type": "string"
            },
            "description": "Search value for filtering leads based on a column."
          },
          {
            "in": "query",
            "name": "pageNo",
            "schema": {
              "type": "string"
            },
            "description": "",
            "required": true
          },
          {
            "in": "query",
            "name": "itemPerPage",
            "schema": {
              "type": "string"
            },
            "description": "",
            "required": true
          },
          {
            "in": "query",
            "name": "pageLimit",
            "schema": {
              "type": "string"
            },
            "description": "",
            "required": true
          },
          {
            "in": "query",
            "name": "advanceFilter",
            "schema": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "column": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "default": [""]
                  },
                  "operator": {
                    "type": "string",
                    "default": "EQUAL",
                    "enum": [
                      "EQUAL",
                      "NOT_EQUAL",
                      "GREATER",
                      "LESSER",
                      "GREATER_THAN_EQUAL",
                      "LESSER_THAN_EQUAL",
                      "CONTAINS",
                      "STARTS_WITH",
                      "ENDS_WITH",
                      "DATE_RANGE"
                    ]
                  },
                  "value": {
                    "type": "string",
                    "default": ""
                  },
                  "logicalOperator": {
                    "type": "string",
                    "default": "AND",
                    "enum": ["AND", "OR"]
                  }
                }
              }
            },
            "description": "Advanced filters for complex lead queries."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/v1/review/tripadvisor-reviews": {
      "get": {
        "tags": ["Review"],
        "summary": "Fetch and store TripAdvisor reviews",
        "description": "Fetches reviews from TripAdvisor and stores them in the database",
        "responses": {
          "200": {
            "description": "TripAdvisor reviews fetched and stored successfully"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  }
}
